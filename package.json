{
  "name": "psf-helm",
  "version": "0.1.0",
  "description": "Drive your robot truck — or fly your drone — by telling it what to do. PSF Helm is a local-first desktop app that pairs natural-language control with any llama.cpp model, runs entirely on your machine, and stays out of the cloud.",
  "author": "Pseudo Science Fiction",
  "license": "Apache-2.0",
  "main": "dist-electron/electron/main.js",
  "bin": {
    "helm": "./dist-cli/cli/helm.js"
  },
  "scripts": {
    "helm-ui": "concurrently -k -n vite,electron -c blue,magenta \"npm:helm-ui:renderer\" \"npm:helm-ui:main\"",
    "helm-ui:renderer": "vite",
    "helm-ui:main": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron .",
    "helm": "tsx cli/helm.ts",
    "build": "npm run build:renderer && npm run build:electron && npm run build:cli",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:cli": "tsc -p cli/tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p electron/tsconfig.json --noEmit && tsc -p cli/tsconfig.json --noEmit",
    "start": "electron .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
