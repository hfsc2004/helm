{
  "id": "sensor-board-v1-3-esp32s3",
  "name": "GSN Robotics - PSF Sensor Board v1.3 (bring-up)",
  "description": "First ESP32-S3-CAM firmware for the PSF Sensor Board v1.3: camera, I2C diagnostics, and RGBW LED test. No motor or collision-control changes.",
  "target": "esp32",
  "fqbn": "esp32:esp32:esp32s3:PSRAM=opi",
  "core": "esp32:esp32",
  "vehicleKind": "ground",
  "capabilities": ["camera.mjpeg"],
  "vars": [
    { "key": "wifi.ssid", "type": "string", "required": true, "label": "WiFi SSID" },
    { "key": "wifi.password", "type": "secret", "required": true, "label": "WiFi password" },
    { "key": "mdns.name", "type": "string", "default": "psf-sensor", "label": "mDNS hostname" },
    { "key": "wifi.useStatic", "type": "boolean", "default": false, "label": "Use a static IP?" },
    { "key": "wifi.staticIp", "type": "string", "default": "192.168.1.51", "label": "Static IP" },
    { "key": "wifi.staticCidr", "type": "number", "default": 24, "label": "Static CIDR prefix (0-32)" },
    { "key": "camera.frameSize", "type": "string", "default": "VGA", "label": "Camera frame size (QVGA | VGA | SVGA | XGA | HD)" },
    { "key": "camera.jpegQuality", "type": "number", "default": 12, "label": "JPEG quality (0..63, lower is better)" }
  ]
}
